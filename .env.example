# Configuración general de Mi Billetera (PostgreSQL + InfluxDB + Grafana)

# Contraseña de la base de datos PostgreSQL
DB_PASSWORD=billetera_local

# Contraseña del usuario "admin" de Grafana
GRAFANA_PASSWORD=admin

# Configuración de InfluxDB (Base de datos de Series de Tiempo)
INFLUX_PASSWORD=adminpassword123
INFLUX_TOKEN=billetera-super-secret-token-influxdb-2024
INFLUX_ORG=billetera_org
INFLUX_BUCKET=billetera_metricas

# Zona horaria (para que "hoy" y "este mes" sean correctos)
ZONA_HORARIA=America/La_Paz

# ---- Grafana Cloud (opcional) ----
PDC_TOKEN=
PDC_CLUSTER=
PDC_GRAFANA_ID=
