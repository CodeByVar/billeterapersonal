# Copia este archivo como ".env" y cambia los valores

# Contraseña de la base de datos (cámbiala ANTES del primer "docker compose up")
DB_PASSWORD=billetera_local

# Contraseña del usuario "admin" de Grafana
GRAFANA_PASSWORD=admin

# Zona horaria (para que "hoy" y "este mes" sean correctos)
ZONA_HORARIA=America/La_Paz

# ---- Grafana Cloud (opcional) ----
# Los 3 valores te los da Grafana Cloud al crear la conexión privada (PDC).
# No compartas el token con nadie.
PDC_TOKEN=
PDC_CLUSTER=
PDC_GRAFANA_ID=
